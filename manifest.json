{
  "id": "/leitor-pdf-ocr",
  "name": "Leitor PDF + OCR",
  "short_name": "Leitor PDF",
  "description": "Leitor de PDF rápido com seleção de texto, modo noturno, compartilhamento e OCR em Português.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#121216",
  "theme_color": "#121216",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot.png",
      "sizes": "720x1600",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tela principal do Leitor PDF com OCR"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "share_target": {
    "action": "./index.html?shared-pdf=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdf",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  }
}